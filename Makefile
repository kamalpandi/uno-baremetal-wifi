# ===========================================================================
# uno-baremetal-wifi
#
# Bare-metal C for the ATmega328P (Arduino Uno R3) talking to a Cytron
# ESP8266 WiFi Shield over a bit-banged UART.
#
# No Arduino core, no libraries. avr-gcc + avrdude only.
# ===========================================================================

# --- Identity of the chip and board ----------------------------------------
TARGET   := uno-wifi
MCU      := atmega328p
F_CPU    := 16000000UL     # Uno R3 crystal. Used by <util/delay.h>.

# --- How we talk to the board ----------------------------------------------
# This board has a CH340 USB-serial bridge, so it shows up as ttyUSB0
# (an official Uno with an ATmega16U2 bridge would be ttyACM0).
PORT       := /dev/ttyUSB0
PROGRAMMER := arduino      # stk500v1 over the Uno bootloader
BAUD       := 115200       # bootloader baud rate

# Debug console baud. Must match BAUD_DEBUG in src/uart0.c.
CONSOLE_BAUD := 115200

# --- Where things live -----------------------------------------------------
SRC_DIR   := src
BUILD_DIR := build

SRCS := $(wildcard $(SRC_DIR)/*.c)
OBJS := $(SRCS:$(SRC_DIR)/%.c=$(BUILD_DIR)/%.o)
DEPS := $(OBJS:.o=.d)      # dependency files generated by -MMD

# --- Compiler flags --------------------------------------------------------
# -Os                     optimise for size (we have 32K flash, but be tidy)
# -ffunction-sections     put each function in its own section...
# -fdata-sections         ...and each variable too, so --gc-sections can
#                         delete everything we never call.
# -MMD -MP                auto-generate header dependencies (.d files)
CFLAGS := -mmcu=$(MCU) -DF_CPU=$(F_CPU) \
          -Os -std=c11 \
          -Wall -Wextra -Wshadow -Wundef \
          -ffunction-sections -fdata-sections -fno-common \
          -I$(SRC_DIR) \
          -MMD -MP

LDFLAGS := -mmcu=$(MCU) -Wl,--gc-sections \
           -Wl,-Map=$(BUILD_DIR)/$(TARGET).map

OBJCOPY := avr-objcopy
SIZE    := avr-size
AVRDUDE := avrdude

# ===========================================================================
# Targets
# ===========================================================================

.PHONY: all hex size flash monitor clean disasm check compdb

all: hex size

# The final artifact: an Intel HEX file ready to burn into flash.
hex: $(BUILD_DIR)/$(TARGET).hex

# Link all objects into an .elf
$(BUILD_DIR)/$(TARGET).elf: $(OBJS) | $(BUILD_DIR)
	avr-gcc $(LDFLAGS) -o $@ $(OBJS)

# Convert the .elf into .hex (drop the .eeprom section, it is handled separately)
$(BUILD_DIR)/$(TARGET).hex: $(BUILD_DIR)/$(TARGET).elf
	$(OBJCOPY) -O ihex -R .eeprom $< $@

# Compile any .c into a matching .o
$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c | $(BUILD_DIR)
	avr-gcc $(CFLAGS) -c $< -o $@

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

# Show how much of the chip we are using. The Uno has 32K flash / 2K RAM,
# and this is the single most useful command in the whole project.
size: $(BUILD_DIR)/$(TARGET).elf
	$(SIZE) --mcu=$(MCU) --format=avr $<

# Disassemble, with C source interleaved. Great for seeing what -Os produced.
disasm: $(BUILD_DIR)/$(TARGET).elf
	avr-objdump -d -S $< | less

# Upload to the board over the bootloader.
#
# The serial port is exclusive: your terminal and the AVR bootloader both
# want the same wire. Check for that up front, because avrdude's own error
# for this situation ("programmer is not responding", "try -B 125kHz") is
# misleading and sends you off debugging wiring that is perfectly fine.
flash: $(BUILD_DIR)/$(TARGET).hex
	@if fuser -s $(PORT) >/dev/null 2>&1; then \
	  echo "error: $(PORT) is busy - something else has it open:"; \
	  fuser -v $(PORT) 2>&1 || true; \
	  echo "       Quit your serial terminal first (picocom: Ctrl-A then Ctrl-X)."; \
	  exit 1; \
	fi
	$(AVRDUDE) -c $(PROGRAMMER) -p $(MCU) -P $(PORT) -b $(BAUD) \
	           -U flash:w:$(BUILD_DIR)/$(TARGET).hex:i

# Attach the debug console. Try `make flash monitor` to do both in one go.
monitor:
	picocom -b $(CONSOLE_BAUD) $(PORT)

clean:
	rm -rf $(BUILD_DIR)

# ===========================================================================
# Editor / language-server support
# ===========================================================================
# clangd (Neovim's C language server) does not read this Makefile, so it has
# no idea we target AVR and cannot find <avr/io.h>. This target writes
# compile_commands.json — one entry per source file, spelling out the exact
# avr-gcc invocation — which clangd reads alongside the .clangd hints.
#
# Regenerate it whenever sources are added or CFLAGS change. It is a build
# artifact, so it is git-ignored.
COMPDB := compile_commands.json

compdb: $(SRCS) | $(BUILD_DIR)
	@printf '[\n' > $(COMPDB)
	@set -- $(SRCS); total=$$#; i=0; \
	for f in $$@; do \
	  i=$$((i + 1)); \
	  obj=$(BUILD_DIR)/$${f##*/}; obj=$${obj%.c}.o; \
	  if [ $$i -eq $$total ]; then sep=; else sep=,; fi; \
	  printf '  {\n    "directory": "%s",\n    "file": "%s",\n    "command": "avr-gcc %s -c %s -o %s"\n  }%s\n' \
	    "$(CURDIR)" "$$f" "$(CFLAGS)" "$$f" "$$obj" "$$sep" >> $(COMPDB); \
	done
	@printf ']\n' >> $(COMPDB)
	@echo "wrote $(COMPDB)"

# Pull in the auto-generated header dependencies (ignored on first build).
-include $(DEPS)
